{% extends '@Forumify/frontend/base.html.twig' %}
{% block meta_tags %}
    {%- set title -%}
        {%- if block('title_page') is not empty -%}
            {{- block('title_page') -}}
            {{- ' - ' -}}
        {%- endif -%}
        {{- setting('forumify.title') -}}
    {%- endset -%}
    {%- set description = metaDescription|default('')|striptags|trim|u.truncate(200, '…', false) -%}
    {%- set image = absolute_url(metaImage ?? logo|trim) -%}
    {%- set canonical = metaCanonical ?? (app.request.schemeAndHttpHost ~ app.request.pathInfo) -%}

    <title>{{ title }}</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="title" content="{{ title }}">
    {% if description is not empty %}
        <meta name="description" content="{{ description }}">
    {% endif %}
    <meta name="image" content="{{ image }}">
    <link rel="canonical" href="{{ canonical }}">

    <meta property="og:type" content="{{ metaType ?? 'website' }}">
    <meta property="og:site_name" content="{{ setting('forumify.title') }}">
    <meta property="og:url" content="{{ canonical }}">
    <meta property="og:title" content="{{ title }}">
    {% if description is not empty %}
        <meta property="og:description" content="{{ description }}">
    {% endif %}
    <meta property="og:image" content="{{ image }}">
    {% if metaImage is defined and metaImage is not null %}
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
    {% endif %}

    <meta name="twitter:card" content="{{ metaImage is defined and metaImage is not null ? 'summary_large_image' : 'summary' }}">
    <meta name="twitter:url" content="{{ canonical }}">
    <meta name="twitter:title" content="{{ title }}">
    {% if description is not empty %}
        <meta name="twitter:description" content="{{ description }}">
    {% endif %}
    <meta name="twitter:image" content="{{ image }}">

    {% block ecommerce_meta_tags %}{% endblock %}
{% endblock %}
