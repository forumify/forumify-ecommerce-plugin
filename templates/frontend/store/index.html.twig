{% extends '@ForumifyEcommercePlugin/frontend/store/base.html.twig' %}
{% set metaDescription = category ? category.description : null %}
{% set metaCanonical = category ? url('ecommerce_store', { category: category.slug }) : url('ecommerce_store') %}
{% block title_page %}
    {%- if category -%}
        {{ category.title }} - {{ 'ecommerce.store.title'|trans }}
    {%- else -%}
        {{ 'ecommerce.store.title'|trans }}
    {%- endif -%}
{% endblock %}
{% block body %}
    {% block ecommerce_store_header %}
        <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
            <h1 class="mb-0">{{ 'ecommerce.store.title'|trans }}</h1>
            {% if is_granted('ROLE_USER') %}
                <a class="btn-outlined" href="{{ path('ecommerce_orders') }}">{{ 'ecommerce.orders.title'|trans }}</a>
            {% endif %}
        </div>
    {% endblock %}
    {% block ecommerce_store_products %}
        {{ component('Ecommerce\\ProductList', { limit: 12 }) }}
    {% endblock %}
    {% block ecommerce_store_footer %}{% endblock %}
{% endblock %}
