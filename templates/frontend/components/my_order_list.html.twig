{% extends '@Forumify/components/list.html.twig' %}
{% block container %}
    <div class="card ecommerce-ledger">
        {% if this.result.rows is not empty %}
            <ul class="ecommerce-ledger-rows">
                {% for order in this.result.rows %}
                    {% set status = order.status.value %}
                    <li>
                        {% block ecommerce_order_row %}
                            <a class="ecommerce-ledger-row" href="{{ path('ecommerce_order', { reference: order.reference }) }}">
                                <span class="ecommerce-ledger-date flex flex-col">
                                    {{ order.createdAt|date('j M Y') }}
                                    <span class="ecommerce-ledger-reference">{{ order.reference }}</span>
                                </span>
                                <span class="ecommerce-ledger-item flex flex-col">
                                    <span class="ecommerce-ledger-title">{{ order.productTitle }}</span>
                                    <span class="ecommerce-ledger-meta">
                                        {{ order.tierLabel }}
                                        {% if order.renewal %}<span class="ecommerce-chip">{{ 'ecommerce.orders.renewal'|trans }}</span>{% endif %}
                                    </span>
                                </span>
                                <span class="ecommerce-ledger-amount">
                                    {{ order.free ? 'ecommerce.price.free'|trans : order.amount|ecommerce_money }}
                                </span>
                                <span class="ecommerce-state is-{{ status }}">{{ ('ecommerce.order_status.' ~ status)|trans }}</span>
                            </a>
                        {% endblock %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        {% block pagination_bottom %}
            {% include '@Forumify/components/components/pagination.html.twig' with { class: 'card-footer' } %}
        {% endblock %}
    </div>
{% endblock %}
