{% extends '@ForumifyEcommercePlugin/frontend/store/base.html.twig' %}
{% set order = subscription.initialOrder %}
{% block title_page %}{{ 'ecommerce.subscriptions.cancel'|trans }}{% endblock %}
{% block body %}
    <div class="ecommerce-page is-narrow">
        <div class="breadcrumbs text-small">
            <a href="{{ path('ecommerce_orders') }}">{{ 'ecommerce.orders.title'|trans }}</a> &gt;
            <a href="{{ subscriptionPath }}">{{ order.productTitle }}</a> &gt;
            <span class="text-secondary">{{ 'ecommerce.subscriptions.cancel'|trans }}</span>
        </div>
        <h1>{{ 'ecommerce.subscriptions.cancel'|trans }}</h1>
        {% block ecommerce_cancel_subscription %}
            <div class="box flex flex-col gap-4">
                <p>
                    {{ 'ecommerce.subscriptions.cancel_summary'|trans({
                        product: order.productTitle ~ ' - ' ~ order.tierLabel,
                        date: subscription.currentPeriodEnd|date('j M Y'),
                    }) }}
                </p>
                {% if ecommerce_fulfillment_is_manual(order.fulfillmentType) %}
                    <p class="text-secondary">{{ 'ecommerce.subscriptions.cancel_manual'|trans }}</p>
                {% endif %}
                <form method="post" class="flex flex-wrap gap-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('ecommerce_cancel_subscription') }}">
                    <button type="submit" class="btn-primary">{{ 'ecommerce.subscriptions.cancel_confirm'|trans }}</button>
                    <a class="btn-outlined" href="{{ subscriptionPath }}">{{ 'ecommerce.subscriptions.cancel_keep'|trans }}</a>
                </form>
            </div>
        {% endblock %}
    </div>
{% endblock %}
