{% set order = subscription.initialOrder %}
{% set product = order.product %}
{% set status = subscription.status.value %}
{% set actions %}{% block ecommerce_plan_actions %}{% endblock %}{% endset %}
<article class="ecommerce-plan is-{{ status }}">
    {% block ecommerce_plan_head %}
        <div class="ecommerce-plan-head">
            <div class="ecommerce-plan-thumb ecommerce-product-tile-image">
                {% if product and product.image %}
                    <img src="{{ asset(product.image, 'ecommerce.asset')|imagine_filter('ecommerce_thumb') }}" alt="">
                {% else %}
                    <span aria-hidden="true">{{ order.productTitle|first|upper }}</span>
                {% endif %}
            </div>
            <div class="flex flex-col flex-grow">
                <h3 class="ecommerce-plan-title">{{ order.productTitle }}</h3>
                <span class="text-secondary">{{ order.tierLabel }}</span>
                {% if detailed|default(false) %}
                    <span class="text-secondary text-small">
                        {{ 'ecommerce.subscriptions.started'|trans({ date: subscription.createdAt|date('j M Y') }) }}
                    </span>
                {% endif %}
            </div>
            <span class="ecommerce-state is-{{ status }}">{{ ('ecommerce.subscription_status.' ~ status)|trans }}</span>
        </div>
    {% endblock %}
    {% block ecommerce_plan_amount %}
        <div class="ecommerce-amount is-compact">
            {% include '@ForumifyEcommercePlugin/frontend/store/_amount.html.twig' with { price: order } only %}
        </div>
    {% endblock %}
    {% block ecommerce_plan_term %}
        {% if status == 'past_due' %}
            <p class="ecommerce-plan-alert">
                {% if subscription.graceEndsAt %}
                    {{ 'ecommerce.subscriptions.past_due_grace'|trans({ date: subscription.graceEndsAt|date('j M Y') }) }}
                {% else %}
                    {{ 'ecommerce.subscriptions.past_due'|trans }}
                {% endif %}
            </p>
        {% else %}
            <p class="ecommerce-plan-term">
                {{ ('ecommerce.subscriptions.period_end.' ~ status)|trans({
                    date: (status == 'ended' ? subscription.endedAt : subscription.currentPeriodEnd)|date('j M Y'),
                }) }}
            </p>
        {% endif %}
    {% endblock %}
    {% if actions|trim is not empty %}
        <div class="ecommerce-plan-actions">{{ actions }}</div>
    {% endif %}
</article>
