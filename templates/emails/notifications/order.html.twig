{% extends '@Forumify/emails/base.html.twig' %}
{% block title %}
    {{ this.title(notification) }}
{% endblock %}
{% block body %}
    <h2>{{ this.title(notification) }}</h2>
    <hr>
    <div class="content-block">
        <p>{{ this.description(notification) }}</p>
    </div>
    {% block ecommerce_email_order_details %}
        {% if order.status.value in ['paid', 'completed'] %}
            <div class="content-block">
                {% include '@ForumifyEcommercePlugin/fulfillment/_details.html.twig' with { order: order } only %}
            </div>
        {% endif %}
    {% endblock %}
    <hr>
    {% set link = this.url(notification) %}
    {% if link %}
        {% include '@Forumify/emails/components/button.html.twig' with {
            href: absolute_url(link),
            label: this.emailActionLabel|trans,
        } only %}
    {% endif %}
{% endblock %}
