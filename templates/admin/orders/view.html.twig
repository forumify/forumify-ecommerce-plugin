{% extends '@Forumify/admin/base.html.twig' %}
{% set title = 'ecommerce.admin.order.title'|trans({ reference: order.reference }) %}
{% block title_page %}{{ title }}{% endblock %}
{% block body %}
    <p class="mb-2">
        <a href="{{ path('ecommerce_admin_orders_list') }}">
            <i class="ph ph-arrow-left"></i> {{ 'ecommerce.admin.order.back'|trans }}
        </a>
    </p>
    <h1 class="mb-4">{{ title }}</h1>
    <div class="box">
        <table>
            <tbody class="text-left">
                {% block ecommerce_admin_order_details %}
                    <tr>
                        <th>{{ 'ecommerce.admin.order.reference'|trans }}</th>
                        <td><code>{{ order.reference }}</code></td>
                    </tr>
                    <tr>
                        <th>{{ 'ecommerce.admin.order.status'|trans }}</th>
                        <td>{{ ('ecommerce.order_status.' ~ order.status.value)|trans }}</td>
                    </tr>
                    <tr>
                        <th>{{ 'ecommerce.admin.order.customer'|trans }}</th>
                        <td>{{ order.user ? order.user.displayName : '-' }}</td>
                    </tr>
                    <tr>
                        <th>{{ 'ecommerce.admin.order.product'|trans }}</th>
                        <td>
                            {{ order.productTitle }} - {{ order.tierLabel }}
                            <span class="text-secondary">(<code>{{ order.productKey }}</code> / <code>{{ order.tierKey }}</code>)</span>
                        </td>
                    </tr>
                    <tr>
                        <th>{{ 'ecommerce.admin.order.price'|trans }}</th>
                        <td>{{ order|ecommerce_price }}</td>
                    </tr>
                    <tr>
                        <th>{{ 'ecommerce.admin.order.payment_provider'|trans }}</th>
                        <td>{{ order.providerKey ?? ('ecommerce.admin.order.no_provider'|trans) }}</td>
                    </tr>
                    <tr>
                        <th>{{ 'ecommerce.admin.order.provider_reference'|trans }}</th>
                        <td>{% if order.providerReference %}<code>{{ order.providerReference }}</code>{% else %}-{% endif %}</td>
                    </tr>
                    <tr>
                        <th>{{ 'ecommerce.admin.order.date'|trans }}</th>
                        <td>{{ order.createdAt|date('Y-m-d H:i') }}</td>
                    </tr>
                    <tr>
                        <th>{{ 'ecommerce.admin.order.paid_at'|trans }}</th>
                        <td>{{ order.paidAt ? order.paidAt|date('Y-m-d H:i') : '-' }}</td>
                    </tr>
                    <tr>
                        <th>{{ 'ecommerce.admin.order.fulfillment_type'|trans }}</th>
                        <td>{{ ecommerce_fulfillment_label(order.fulfillmentType)|trans }}</td>
                    </tr>
                    <tr>
                        <th>{{ 'ecommerce.admin.order.completed_at'|trans }}</th>
                        <td>
                            {{ order.completedAt ? order.completedAt|date('Y-m-d H:i') : '-' }}
                            {% if order.completedBy %}
                                <span class="text-secondary">{{ 'ecommerce.admin.order.completed_by'|trans({ user: order.completedBy.displayName }) }}</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% if subscription %}
                        <tr>
                            <th>{{ 'ecommerce.admin.subscription.single'|trans }}</th>
                            <td>
                                {% set subscriptionStatus = ('ecommerce.subscription_status.' ~ subscription.status.value)|trans %}
                                {% if is_granted('ecommerce.admin.subscriptions.view') %}
                                    <a href="{{ path('ecommerce_admin_subscriptions_view', { id: subscription.id }) }}">{{ subscriptionStatus }}</a>
                                {% else %}
                                    {{ subscriptionStatus }}
                                {% endif %}
                                {% if order.renewal %}
                                    <span class="tag">{{ 'ecommerce.orders.renewal'|trans }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endif %}
                {% endblock %}
            </tbody>
        </table>
    </div>
    {% block ecommerce_admin_order_fulfillment %}
        <div class="mt-4">
            {% include '@ForumifyEcommercePlugin/fulfillment/_details.html.twig' with { order: order } only %}
        </div>
        {% if completeForm %}
            <div class="box mt-4">
                <h2 class="mt-0">{{ 'ecommerce.admin.order.complete'|trans }}</h2>
                <p class="help-text mb-4">
                    {{ (ecommerce_fulfillment_is_manual(order.fulfillmentType) ? 'ecommerce.admin.order.complete_help' : 'ecommerce.admin.order.complete_help_automatic')|trans }}
                </p>
                {{ form_start(completeForm) }}
                {{ form_widget(completeForm) }}
                <button type="submit" class="btn-primary">{{ 'ecommerce.admin.order.complete'|trans }}</button>
                {{ form_end(completeForm) }}
            </div>
        {% endif %}
    {% endblock %}
{% endblock %}
