{% extends '@ForumifyEcommercePlugin/admin/dashboard/components/action_list.html.twig' %}
{% set title = 'ecommerce.admin.dashboard.orders_to_process' %}
{% block row %}
    <div class="flex flex-col">
        <a href="{{ path('ecommerce_admin_orders_view', { id: item.id }) }}">
            <code>{{ item.reference }}</code> {{ item.productTitle }} - {{ item.tierLabel }}
        </a>
        <span class="text-small text-secondary">
            {{ item.user ? item.user.displayName : '-' }} · {{ ecommerce_fulfillment_label(item.fulfillmentType)|trans }}
        </span>
    </div>
    <div class="flex items-center gap-2 text-small">
        {% if not ecommerce_fulfillment_is_manual(item.fulfillmentType) %}
            <span class="tag tag-error">{{ 'ecommerce.admin.dashboard.stuck'|trans }}</span>
        {% endif %}
        {% include '@ForumifyEcommercePlugin/admin/dashboard/components/_waiting.html.twig' with { since: item.paidAt } only %}
    </div>
{% endblock %}
