{% extends '@ForumifyEcommercePlugin/admin/dashboard/components/action_list.html.twig' %}
{% set title = 'ecommerce.admin.dashboard.pending_refunds' %}
{% block row %}
    <div class="flex flex-col">
        <a href="{{ path('ecommerce_admin_orders_view', { id: item.order.id }) }}">
            <code>{{ item.order.reference }}</code> {{ item.order.amount|ecommerce_money }}
        </a>
        <span class="text-small text-secondary">
            {{ item.user ? item.user.displayName : '-' }} ·
            {{ item.reason|length > 80 ? item.reason|slice(0, 80) ~ '…' : item.reason }}
        </span>
    </div>
    {% include '@ForumifyEcommercePlugin/admin/dashboard/components/_waiting.html.twig' with { since: item.createdAt } only %}
{% endblock %}
